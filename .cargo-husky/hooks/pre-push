#!/usr/bin/env bash
set -euo pipefail

# Test the crates this push actually touches.
#
# History: this hook ran `cargo check` only and deferred by comment to
# `.github/workflows/ci.yml` "which triggers on every pull_request". That workflow is
# `disabled_manually`, so the claim was false and the full gate was enforced by no machine —
# CLAUDE.md's "Known hole". #1074 is what it cost: a constant bumped, four tests left stale on
# `main`, plus a fifth that had gone vacuous, unnoticed until someone read the file by accident.
#
# Why a subset and not the full gate: the full gate takes ~15 minutes, and a hook that slow is a
# hook people learn to `--no-verify` past. #1074 was caught in ~1 minute by testing only the crate
# it touched, because `cargo build` and `cargo clippy` both passed and only a *test* run saw it.
#
# What this hook does NOT cover, stated because an earlier version of this comment claimed the full
# gate "runs at merge" and it does not (#1144):
#   - `scripts/gate.sh` still does not run BEFORE a merge. In CI it runs on a `release/**` head
#     branch or manual dispatch (#1120), and since #1144 also on a push to `main`
#     (`.github/workflows/post-merge-gate.yml`) — which is DETECTION, on a tip that is already
#     shared, not prevention. No status check requires the gate. Run it yourself before merging.
#   - REVERSE DEPENDENTS of a leaf crate. Only the crates OWNING changed files are tested, plus —
#     since work plan decision 9 (2026-09-30) — every reverse dependent when the push touches one of
#     the core libraries (`openpulse-core`, `openpulse-dsp`, `openpulse-modem`). That closes
#     #1074's exact shape (a core change breaking a downstream test). For any other crate the
#     reverse dependents are still only NAMED (see that block). `HOOK_REVDEPS=0 git push` skips the
#     reverse-dependent run, visibly.
#
# Escape hatch: `GATE_SKIP=1 git push`. Note `git push --no-verify` already bypasses this hook
# silently, so this exists to make skipping deliberate and visible, not to prevent it.

if [ "${GATE_SKIP:-0}" = "1" ]; then
    echo "pre-push: SKIPPED via GATE_SKIP=1 — the full gate has not run on this push."
    exit 0
fi

# Refuse to run as a stale copy (#1448). cargo-husky installs the versioned hook once and never
# updates it, so the hook git runs can silently lack later passes. Compare this installed copy with
# the versioned one, ignoring the two header lines cargo-husky inserts, and stop with the one-line
# refresh when they differ. `scripts/gate.sh` runs the same comparison.
repo_root="$(git rev-parse --show-toplevel)"
installed_hook="$(git rev-parse --git-path hooks/pre-push)"
versioned_hook="$repo_root/.cargo-husky/hooks/pre-push"
normalise_hook() { sed -e '2{/^#$/{N;/set by cargo-husky/d;};}' "$1"; }
if [ -f "$installed_hook" ] && [ -f "$versioned_hook" ] \
    && ! cmp -s <(normalise_hook "$installed_hook") <(normalise_hook "$versioned_hook"); then
    echo "pre-push: FAIL — the installed hook differs from .cargo-husky/hooks/pre-push (#1448)."
    echo "pre-push:   refresh it: cp \"$versioned_hook\" \"$installed_hook\""
    exit 1
fi

# Queue behind any other heavy build on this machine, in any project, rather than
# race it for RAM. After the escape hatch, so a deliberate skip never waits.
# shellcheck source=scripts/lib/host-build-lock.sh
source "$(git rev-parse --show-toplevel)/scripts/lib/host-build-lock.sh" "pre-push"

cargo fmt --all -- --check

# The base this push is measured against: what it ADDS relative to where it will land.
# `@{u}` is that base only while it is an ancestor of HEAD. After a rebase (or any rewrite) the
# upstream ref still names the pre-rebase commit, `merge-base(@{u}, HEAD)` falls back to the OLD
# fork point, and both the tested crate set and the lint range widened to commits `main` gained in
# between (#1357: a push with no Rust paid a four-crate run, and the lint could block on a hit the
# pusher never wrote). So use `@{u}` when it is an ancestor of HEAD — which keeps a stacked branch
# measured against the branch it stacks on — and `origin/main` otherwise, including a first push.
upstream="$(git rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null || echo '')"
base="origin/main"
if [ -n "$upstream" ]; then
    if git merge-base --is-ancestor "$upstream" HEAD 2>/dev/null; then
        base="$upstream"
    else
        echo "pre-push: $upstream is not an ancestor of HEAD (rebased?) — measuring against origin/main (#1357)"
    fi
fi
changed="$(git diff --name-only "$base"...HEAD 2>/dev/null || echo '')"

pkgs=""
while IFS= read -r f; do
    [ -n "$f" ] || continue
    d="$(dirname "$f")"
    while [ "$d" != "." ] && [ "$d" != "/" ]; do
        if [ -f "$d/Cargo.toml" ]; then
            name="$(grep -m1 '^name *= *' "$d/Cargo.toml" | sed 's/.*"\(.*\)".*/\1/')"
            [ -n "$name" ] && pkgs="$pkgs $name"
            break
        fi
        d="$(dirname "$d")"
    done
done <<< "$changed"

pkgs="$(printf '%s\n' $pkgs | sort -u | tr '\n' ' ')"

# Re-homed doc / attribute lint (#1345). This hook is the only check that runs on EVERY push (#1144),
# and the lint takes under a second. It lints what this push adds (the upstream, else origin/main);
# the script prints the range, so an empty one is visible. It exits 2 on an unresolvable base, and
# `set -e` then blocks the push rather than letting it through unlinted. It uses the same `$base` as
# the crate set, so after a rebase it no longer covers commits `main` gained in between (#1357).
scripts/check-rehomed-docs.sh --base "$base"

cargo clippy --workspace --no-default-features --all-targets -- -D warnings

# The shipped (feature-off) configuration — see scripts/gate.sh for the full why (#1418). The line
# above cannot see it: `--all-targets` pulls dev units in, and dev-dep features then unify into the
# normal build, so the lib is linted with `instruments` ON while the release binary links it OFF.
# It belongs here and not only in the gate because this hook is the only check that runs on EVERY
# push (#1144), and the pass costs ~1 s warm. Measured: without it, this hook returns 0 on a planted
# E0599 that breaks `cargo build --release --no-default-features`.
cargo clippy --workspace --no-default-features -- -D warnings

# Feature-gated code, which neither pass above COMPILES at all (#1380) — see scripts/gate.sh for the
# full reasoning and the two stated limits. Here because rot is a per-push class and this hook is the
# only check that runs on every push (#1144). Worst case (an edit in openpulse-core) this re-checks
# the workspace in a second feature configuration, ~40 s measured; a leaf-crate edit is seconds.
#
# The preflight exists so a missing distro package reads as a missing distro package: --all-features
# pulls alsa-sys, libudev-sys and libdbus-sys, whose build scripts call pkg_config and PANIC, which
# would otherwise surface as a backtrace buried in clippy output.
missing_pc=""
for pc in alsa libudev dbus-1; do
    pkg-config --exists "$pc" 2>/dev/null || missing_pc="$missing_pc $pc"
done
if [ -n "$missing_pc" ]; then
    echo "pre-push: FAIL — --all-features needs pkg-config:$missing_pc"
    echo "pre-push:   install libasound2-dev libudev-dev libdbus-1-dev (Debian/Ubuntu names)"
    exit 1
fi
cargo clippy --workspace --all-features --all-targets -- -D warnings

if [ -z "${pkgs// /}" ]; then
    echo "pre-push: no crate-owned changes detected; fmt + clippy only."
    exit 0
fi

# Reverse dependents of the touched crates (#1144 part 3, item 4; work plan decision 9).
#
# `cargo metadata`'s `dependencies` includes DEV-dependencies, and they are kept on purpose: a
# dev-dependent's TESTS are exactly what a behavioural break shows up in. So this set is wider than
# a pure build-graph reverse-dependency set, and that is the correct width for the question.
#
# Each state gets its own sentence, from its own exit status: metadata failed, the closure failed,
# or a real answer. A zero from a filter is a claim about the filter. The `&& rc=0 || rc=$?` form
# keeps `set -e` from exiting on a failed substitution before the state can be reported.
revdeps_state="ok"
metadata_err="$(mktemp)"
meta="$(cargo metadata --format-version 1 --no-deps 2>"$metadata_err")" && meta_rc=0 || meta_rc=$?
revdeps=""
if [ "$meta_rc" -ne 0 ]; then
    revdeps_state="cargo metadata exited $meta_rc: $(head -1 "$metadata_err")"
else
    # The pipe here SHAPES INPUT; the verdict comes from python's own status in $py_rc, never from
    # the pipeline. Python exits 2 on any parse failure so it can never be mistaken for "no results".
    revdeps="$(printf '%s' "$meta" | python3 -c '
import json, sys
try:
    meta = json.load(sys.stdin)
except Exception as e:
    print(f"closure: {e}", file=sys.stderr)
    sys.exit(2)
touched = set(sys.argv[1].split())
members = {p["name"]: {d["name"] for d in p.get("dependencies", [])} for p in meta.get("packages", [])}
# Transitive closure: a break travels more than one hop (openpulse-dsp -> plugin -> modem -> daemon
# is the common case, and direct-only would name 10 of the 23 crates it can reach).
downstream, frontier = set(), set(touched)
while frontier:
    nxt = {name for name, deps in members.items() if deps & frontier} - downstream - touched
    downstream |= nxt
    frontier = nxt
# ONE line: the member count, then the names. Two lines would not survive — `$(...)` strips
# trailing newlines, so an empty name list collapses into the count and `tail -1` hands back the
# number as if it were a crate. Measured: that printed `cargo test -p 41`.
print(len(members), *sorted(downstream))
' "$pkgs")" && py_rc=0 || py_rc=$?
    [ "$py_rc" -eq 0 ] || revdeps_state="the closure computation exited $py_rc"
fi
rm -f "$metadata_err"

total=0; names=""; count=0
if [ "$revdeps_state" = "ok" ]; then
    # shellcheck disable=SC2086
    set -- $revdeps
    total="$1"; shift
    names="$*"; count=$#
fi

# Decision 9: a push touching a core library also tests everything downstream of it. These three
# are the libraries whose behaviour other crates' tests depend on; a leaf crate's reverse
# dependents are only named below, because testing them on every push would make the hook slow
# enough to be skipped. If the reverse-dependent set cannot be computed, the safe direction is the
# whole workspace, not the touched crates alone.
core_touched=""
for p in $pkgs; do
    case " openpulse-core openpulse-dsp openpulse-modem " in
        *" $p "*) core_touched="$core_touched $p" ;;
    esac
done

test_workspace=0
test_pkgs="$pkgs"
revdeps_tested=0
if [ -n "$core_touched" ]; then
    if [ "${HOOK_REVDEPS:-1}" = "0" ]; then
        echo "pre-push: HOOK_REVDEPS=0 — NOT testing the reverse dependents of$core_touched (decision 9 skipped)."
    elif [ "$revdeps_state" != "ok" ]; then
        echo "pre-push: reverse dependents UNKNOWN ($revdeps_state) — testing the whole workspace instead."
        test_workspace=1
    else
        echo "pre-push:$core_touched changed — also testing its $count reverse dependent(s) (decision 9)."
        test_pkgs="$pkgs $names"
        revdeps_tested=1
    fi
fi

if [ "$test_workspace" -eq 1 ]; then
    echo "pre-push: testing the whole workspace"
    cargo test --workspace --no-default-features --no-fail-fast
    echo "pre-push: workspace tests passed."
else
    echo "pre-push: testing:$(printf ' %s' $test_pkgs)"
    args=""
    for p in $test_pkgs; do args="$args -p $p"; done
    # shellcheck disable=SC2086
    cargo test $args --no-default-features --no-fail-fast
    echo "pre-push: tests passed —$(printf ' %s' $test_pkgs)"
fi

# For a leaf-crate push, NAME the reverse dependents that were not tested. Naming is all this does:
# testing them on every push would recreate the slow hook #1074's postmortem says people skip.
if [ "$test_workspace" -eq 0 ] && [ "$revdeps_tested" -eq 0 ]; then
    if [ "$revdeps_state" != "ok" ]; then
        echo "pre-push: reverse dependents UNKNOWN — $revdeps_state"
    elif [ "$count" -eq 0 ]; then
        echo "pre-push: no workspace crate depends on $pkgs— nothing downstream was skipped."
    elif [ "$count" -ge $(( total / 2 )) ]; then
        # Naming 31 of 40 crates is "the workspace", and a wall of names trains people to skip
        # the hook's output entirely. Say so, and point at the one command that covers it.
        echo "pre-push: NOT run — $count of $total workspace crates depend on $pkgs"
        echo "pre-push:   that is effectively the whole workspace: run scripts/gate.sh."
    else
        echo "pre-push: NOT run — $count reverse dependent(s) of $pkgs— to cover them:"
        echo "pre-push:   cargo test --no-default-features$(printf ' -p %s' $names)"
    fi
fi

echo "pre-push: NOT run: the full workspace gate."
# `scripts/gate.sh` runs on a push to `main` (.github/workflows/post-merge-gate.yml, #1144), so a
# break IS detected — AFTER the merge, on a tip that is already shared. Decision 9 moves the full
# gate to once a day and before every tag; it is still not a pre-merge check.
echo "pre-push: the gate runs post-merge on main (detection, not prevention); run it daily and before every tag."
